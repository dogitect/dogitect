{
  "mcpServers": {
    "angular-mcp": {
      "command": "npx",
      "args": ["-y", "@angular/cli", "mcp"]
    },
    "playwright-mcp": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "chrome-devtools-mcp": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp"]
    }
  }
}
