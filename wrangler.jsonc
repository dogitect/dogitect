{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dogitect",
  "compatibility_date": "2026-11-18",
  "main": "workers/dogitect.ts",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/dogitect/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "none",
    "run_worker_first": true,
  },
  "routes": [
    { "pattern": "dogitect.com", "custom_domain": true },
    { "pattern": "www.dogitect.com", "custom_domain": true },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
